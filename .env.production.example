# Copy this file to .env.production on the Linux server.
# Never commit .env.production.

MEDIACMS_IMAGE=mediacms/mediacms:latest
MEDIACMS_WORKER_IMAGE=mediacms/mediacms:full
APP_HTTP_PORT=8080

FRONTEND_HOST=https://video.example.com
ALLOWED_HOSTS=video.example.com
CSRF_TRUSTED_ORIGINS=https://video.example.com
CORS_ALLOWED_ORIGINS=https://video.example.com
PORTAL_NAME=MediaCMS

DEBUG=False
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

POSTGRES_DB=mediacms
POSTGRES_NAME=mediacms
POSTGRES_USER=mediacms
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_LOCATION=redis://redis:6379/1

# Personalized recommendations remain disabled until behavior data and the
# item-similarity cache have been verified in this environment.
ENABLE_COLLABORATIVE_FILTERING=False
COLLABORATIVE_FILTERING_MIN_INTERACTIONS=3

SECRET_KEY=REPLACE_WITH_A_DJANGO_SECRET_KEY
ADMIN_USER=REPLACE_WITH_A_NON_DEFAULT_ADMIN_NAME
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ADMIN_PASSWORD
